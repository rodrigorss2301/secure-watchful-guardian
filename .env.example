# Copie para .env e preencha com os valores do SEU projeto Supabase.
# O .env real nao vai para o git.

SUPABASE_PROJECT_ID="<ref-do-projeto>"
SUPABASE_URL="https://<ref-do-projeto>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<chave-publica-anon>"

VITE_SUPABASE_PROJECT_ID="<ref-do-projeto>"
VITE_SUPABASE_URL="https://<ref-do-projeto>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<chave-publica-anon>"

# NUNCA colocar aqui nem no .env versionado.
# Vai apenas nos secrets do ambiente de deploy:
#   SUPABASE_SERVICE_ROLE_KEY
#   TAILSCALE_AUTH_KEY
